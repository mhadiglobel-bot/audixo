# Configure these securely in Vercel Project Settings -> Environment Variables.
# Do NOT commit real credentials or an actual cookies.txt file.
AUDIXO_COOKIE_PASSWORD=replace-with-a-long-private-password
AUDIXO_SIGNING_SECRET=replace-with-a-different-random-32-byte-or-longer-secret
# BLOB_READ_WRITE_TOKEN is added by connecting a PRIVATE Vercel Blob store.
